NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active Founding Member product and $499/year recurring Price. Do not reuse
# legacy $299 Founder Product/Price IDs for this checkout.
STRIPE_FOUNDING_MEMBER_PRODUCT_ID=
STRIPE_FOUNDING_MEMBER_PRICE_ID=
# Existing deployment aliases. New checkout accepts these only when Stripe's
# server-side validation confirms the current active $499/year recurring offer.
# The product ID also remains available for historical $299 reconciliation.
STRIPE_FOUNDING_PRODUCT_ID=
STRIPE_FOUNDING_VENDOR_PRICE_ID=
# Recurring membership Products and Prices created on the platform account.
STRIPE_NETWORK_PRODUCT_ID=
STRIPE_NETWORK_MEMBER_PRICE_ID=
STRIPE_PREFERRED_PRODUCT_ID=
STRIPE_PREFERRED_VENDOR_PRICE_ID=
# Stripe Connect marketplace configuration (server-only).
# Marketplace fee decision: 300 = 3%; 0 would mean the
# platform deliberately absorbs Stripe processing fees, refunds, and disputes.
STRIPE_CONNECT_APPLICATION_FEE_BPS=300
# Snapshot destination for Checkout payment lifecycle events.
STRIPE_MARKETPLACE_WEBHOOK_SECRET=
# Thin destination for V2 Account requirements/capability events.
STRIPE_CONNECT_THIN_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_FOUNDING_FIFTY_PLAN_OR_PRODUCT_ID=
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_PAYMENT_URL=
