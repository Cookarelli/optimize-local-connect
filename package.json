{
  "name": "optimize-local-connect",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:firestore && npm run test:storage && npm run test:migration && npm run typecheck && npm run lint",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "test:firestore": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 XDG_CONFIG_HOME=/private/tmp/olc-firebase-config firebase emulators:exec --only firestore --project demo-optimize-local-connect \"node --conditions=react-server --import tsx --test --test-concurrency=1 tests/founder-firestore.emulator.ts tests/firebase-platform.emulator.ts\"",
    "test:storage": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 XDG_CONFIG_HOME=/private/tmp/olc-firebase-config firebase emulators:exec --only firestore,storage --project demo-optimize-local-connect \"node --import tsx --test tests/firebase-storage.emulator.ts\"",
    "test:migration": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=1 XDG_CONFIG_HOME=/private/tmp/olc-firebase-config firebase emulators:exec --only auth,firestore --project demo-optimize-local-connect \"node --conditions=react-server --import tsx --test tests/firebase-migration.emulator.ts\"",
    "seed:founders": "node --conditions=react-server --import tsx scripts/seed-founder-categories.ts",
    "seed:firebase:staging": "node --conditions=react-server --import tsx scripts/seed-firebase-staging.ts",
    "deliver:firebase:notifications": "node --conditions=react-server --import tsx scripts/deliver-firebase-notifications.ts",
    "rehearse:firebase:staging": "node --conditions=react-server --import tsx scripts/rehearse-firebase-staging.ts",
    "verify:firebase:staging-rules": "node --conditions=react-server --import tsx scripts/verify-firebase-staging-rules.ts",
    "configure:firebase:staging-auth": "node --conditions=react-server --import tsx scripts/configure-firebase-staging-auth.ts",
    "migrate:firebase:auth": "node --conditions=react-server --import tsx scripts/firebase-migration/import-auth.ts",
    "migrate:firebase:data": "node --conditions=react-server --import tsx scripts/firebase-migration/import-data.ts",
    "migrate:firebase:founders": "node --conditions=react-server --import tsx scripts/prepare-founder-operational-profiles.ts",
    "migrate:firebase:catalog": "node --conditions=react-server --import tsx scripts/prepare-firebase-platform-catalog.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel --ignore-pattern .vinext --ignore-pattern .wrangler",
    "dev:next": "next dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.1",
    "@supabase/supabase-js": "^2.110.3",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.27",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.27.0",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.8",
    "supabase": "^2.109.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "type": "module"
}
